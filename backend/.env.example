# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# DATABASE
# ==========================================
# Prefer DATABASE_URL in production platforms.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jana_distribution
DB_USER=postgres
DB_PASSWORD=change_me

# ==========================================
# REDIS
# ==========================================
# Prefer REDIS_URL in production platforms.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# AUTH
# ==========================================
# OBLIGATOIRE — chaîne aléatoire longue (≥ 32 caractères). Utilisée pour signer les access tokens.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# OBLIGATOIRE — chaîne aléatoire DIFFÉRENTE de JWT_SECRET. Le serveur refuse de démarrer si absent ou identique.
JWT_REFRESH_SECRET=replace_with_another_distinct_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ==========================================
# SECURITY / CORS
# ==========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Limiteur global sur /api/auth (inscription, login, refresh, changement mdp)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
# Limiteur strict dédié à /api/auth/forgot-password et /api/auth/reset-password
# (anti-énumération d'emails et brute-force de tokens de reset)
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5
CORS_ORIGIN=http://localhost:5173

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info

# ==========================================
# EMAIL (Brevo)
# ==========================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Jana Distribution
FRONTEND_URL=http://localhost:5173

# ==========================================
# STRIPE (Paiement carte)
# ==========================================
# Clé secrète serveur (sk_test_... en dev, sk_live_... en prod)
STRIPE_SECRET_KEY=
# Secret de signature des webhooks (whsec_...) — fourni par Stripe CLI en dev
# ou par le dashboard Stripe lors de la création du webhook en prod.
STRIPE_WEBHOOK_SECRET=
# Clé publique (pk_test_... / pk_live_...) — à exposer au frontend via
# VITE_STRIPE_PUBLISHABLE_KEY dans frontend/.env
STRIPE_PUBLISHABLE_KEY=
