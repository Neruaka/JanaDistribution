# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# DATABASE
# ==========================================
# Prefer DATABASE_URL in production platforms.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jana_distribution
DB_USER=postgres
DB_PASSWORD=change_me

# ==========================================
# REDIS
# ==========================================
# Prefer REDIS_URL in production platforms.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# AUTH
# ==========================================
# OBLIGATOIRE — chaîne aléatoire longue (≥ 32 caractères). Utilisée pour signer les access tokens.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# OBLIGATOIRE — chaîne aléatoire DIFFÉRENTE de JWT_SECRET. Le serveur refuse de démarrer si absent ou identique.
JWT_REFRESH_SECRET=replace_with_another_distinct_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ==========================================
# SECURITY / CORS
# ==========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Limiteur global sur /api/auth (inscription, login, refresh, changement mdp)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
# Limiteur strict dédié à /api/auth/forgot-password et /api/auth/reset-password
# (anti-énumération d'emails et brute-force de tokens de reset)
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5
CORS_ORIGIN=http://localhost:5173

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info

# ==========================================
# EMAIL (Brevo)
# ==========================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Jana Distribution
FRONTEND_URL=http://localhost:5173

# ==========================================
# PAIEMENT
# ==========================================
# Pas de paiement en ligne (MVP) — décision client.
# Modes acceptés : ESPECES (livraison), VIREMENT, CHEQUE.
# Stripe a été entièrement retiré du projet.

# ==========================================
# CLOUDFLARE R2 — Stockage images produits
# ==========================================
# Laisser vide en dev (stockage disque local /uploads/products/)
# Obligatoire en prod pour images persistantes (Railway filesystem est éphémère)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jana-products
R2_PUBLIC_URL=

# ==========================================
# INFORMATIONS ENTREPRISE (factures)
# ==========================================
ENTREPRISE_NOM=Jana Distribution
ENTREPRISE_SIRET=798787784
ENTREPRISE_TVA_NUMERO=FR92798787784
# ⚠️ OBLIGATOIRE sur les factures avant toute vente réelle :
ENTREPRISE_ADRESSE=<adresse complète du siège à renseigner>
