# ==========================================
# DOCKER COMPOSE - JANA DISTRIBUTION
# Copier ce fichier vers .env a la racine du projet.
# ==========================================

# Ports externes
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3000
FRONTEND_PORT=5173
ADMINER_PORT=8080

# Base de donnees
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jana_distribution

# Backend
NODE_ENV=development
# OBLIGATOIRE — le backend refuse de demarrer si absent, ou si identique a JWT_SECRET.
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_distinct_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Frontend build
# En docker-compose, /api est proxyfie par Nginx frontend vers le service backend.
VITE_API_URL=/api

# Email SMTP (optionnel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
