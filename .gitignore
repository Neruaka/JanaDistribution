# ==========================================
# FICHIERS TEST
# ==========================================
# reports/
# screenshots/
# tests/

# Images produits uploadees (stockage local dev / volume Fly en prod) - donnees
# runtime binaires, jamais versionnees. Chemin rooté pour eviter le meme piege
# que "scripts/" plus bas (un motif non-rooté aurait aussi matché tout dossier
# "uploads" a n'importe quelle profondeur).
/backend/uploads/

# ==========================================
# FICHIERS SCRIPTS (dossier scripts/ a la racine uniquement — outils locaux
# hors perimetre applicatif. Sans le "/" en tete, ce motif matchait aussi
# backend/scripts/ a n'importe quelle profondeur : ca a silencieusement
# empeche backend/scripts/run-migrations.js et la migration 0001 d'etre
# jamais commites depuis le tout premier commit du projet, cause racine
# de la dette technique "npm run migrate inutilisable sur un env propre")
# ==========================================
/scripts/

# ==========================================
# SECRETS (filet de securite, T13-22 — aucun de ces fichiers n'est
# actuellement tracke, mais aucun pattern ne protegeait contre un ajout
# accidentel futur)
# ==========================================
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
*.sql.gz
*.dump
*.bak

# ==========================================
# OUTILS LOCAUX (hors périmètre applicatif)
# ==========================================
# tools/star-office-ui : dashboard de supervision multi-agents, clone tiers avec son
# propre historique git — non versionné dans ce dépôt. Voir tools/star-office-ui/README.md.
/tools/