# ==========================================
# CONFIGURATION FRONTEND - JANA DISTRIBUTION
# ==========================================
# Copier ce fichier en .env.production pour la production

# ==========================================
# URL DE L'API BACKEND
# ==========================================
# En développement: http://localhost:3000/api
# En production: https://ton-backend.railway.app/api
VITE_API_URL=https://ton-backend.railway.app/api

# ==========================================
# STRIPE (Paiement carte)
# ==========================================
# Clé publique Stripe — pk_test_... en dev, pk_live_... en prod.
# Le flow actuel est Stripe Checkout (redirect), donc cette clé n'est PAS
# strictement nécessaire côté front. Elle est prévue pour un futur passage
# à Stripe Elements / Payment Element sans casser l'environnement.
VITE_STRIPE_PUBLISHABLE_KEY=

# ==========================================
# AUTRES VARIABLES (optionnelles)
# ==========================================
# VITE_APP_NAME=Jana Distribution
# VITE_APP_VERSION=1.0.0
